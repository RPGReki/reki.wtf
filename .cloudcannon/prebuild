#!/bin/bash

STORIES=(crystaldown scions amauga reincarnated-as-cat)

# Prepare Posts
rm -rf personal-blog
git clone https://oauth2:${GITLAB_TOKEN}@gitlab.com/0xReki/personal-blog.git
mkdir -p site/_posts/personal
cp -r personal-blog/_posts/* site/_posts/personal

for i in ${STORIES[@]}; do
  rm -rf ${i}
  git clone https://oauth2:${GITLAB_TOKEN}@gitlab.com/0xReki.WN/${i}.git

  rm -rf site/_posts/${i}
  mkdir -p site/_posts/${i}
  cp -r ${i}/_posts/* site/_posts/${i}/
  
  rm -rf site/${i}
  mkdir -p site/${i}
  cp -r ${i}/pages/* site/${i}/
done

bundle exec jekyll b

rm -rf site/tags
bash docs/.dev/createTags.sh

cp {docs/.dev/js/,theme/assets/2021/scripts/}early.min.js
cp {docs/.dev/js/,theme/assets/2021/scripts/}late.min.js
