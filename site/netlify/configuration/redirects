## ShortURLs

{% assign pages = site.pages | where_exp: "shortlink", "shortlink" -%}{%- for p in pages -%}
{%- capture p_time -%}{{ p.date | date: '%s' }}{%- endcapture -%}
{%- capture p_sponsor_time -%}{{ p.date | date: '%s' | minus: 648000 }}{%- endcapture -%}
{% for from in p.shortlink %}{%- if p.published == true and p_time <= now -%}
{%- assign su = from -%}
{%- for s in site.shorturl -%}
{%- assign su = su | replace: s.prefix,  s.url -%}
{%- endfor -%}

{{ su }}*    {{ p.url | absolute_url }}{%- elsif p.published == "external" -%}

{{ su }}*     p=:p    {{ p.external }}?bugfix 302!
{{ su }}*    {{ p.external }} 302!
{{ p.url }}*    p=:p    {{ p.external }}?bugfix 302!
{{ p.url }}*    {{ p.external }} 302!

{% elsif p.published == "private" %}
{%- assign su = from -%}
{%- for s in site.shorturl -%}
{%- assign su = su | replace: s.prefix, s.url -%}
{%- endfor -%}
{{ su }}*    p={{ p.token }}    {{ p.url | absolute_url }}    200
{{ su }}*    /401.html    401

{% elsif p_time > now %}
{%- assign su = from -%}
{%- for s in site.shorturl -%}
{%- assign su = su | replace: s.prefix, s.url -%}
{%- endfor -%}
{%- if p.chapter -%}
{%- assign token = site.token.max | divided_by: p.chapter | modulo: site.token.mod | plus: site.token.plus -%}
{%- else -%}
{%- assign token = '000000' -%}
{%- endif -%}
{{ su }}*    p={{ token }}    {{ p.url | absolute_url }}    200
{{ su }}*    p=:p             /401.html      401
{{ su }}*                     /402.html      402

{% else %}
{%- assign su = from -%}
{%- for s in site.shorturl -%}
{%- assign su = su | replace: s.prefix, s.url -%}
{%- endfor -%}
{{ su }}*    {{ p.url }}
{% endif %}
{% endfor %}{% endfor %}

