---
layout: null
sitemap: false
---
{
    "routes": [
        {
            "from": "/discord/.*",
            "to": "https://discord.gg/8DCZWGc",
            "status": 301
        },
        
        {% assign pages = site.pages | where: "type", "chapter" | where: "published", true | where: "book.series", "Crystal Down" | sort: "chapter" %}
        {
            "from": "/crystaldown/latest/.*",
            "to": "{{ pages.last.url }}",
            "status": 302
        },
        {% assign pages = site.pages | where: "type", "chapter" | where: "published", true | where: "book.series", "Crystal Down: Scions" | sort: "chapter" %}
        {  
            "from": "/scions/latest/.*",
            "to": "{{ pages.last.url }}",
            "status": 302
        },
        {% assign pages = site.pages | where: "type", "chapter" | where: "published", true | where: "book.series", "Amauga" | sort: "chapter" %}
        {
            "from": "/amauga/latest/.*",
            "to": "{{ pages.last.url }}",
            "status": 302
        },

        {% assign pages = site.posts | where_exp: "redirect_from", "redirect_from" %}{% for page in pages %}{% for from in page.redirect_from %}
        {
            "from": "{{ from }}/.*",
            "to": "{{ page.url }}",
            "status": 301
        },
        {% endfor %}{% endfor %}

        {% assign pages = site.pages | where_exp: "redirect_from", "redirect_from" %}{% for page in pages %}{% for from in page.redirect_from %}
        {
            "from": "{{ from }}/.*",
            "to": "{{ page.url }}",
            "status": 301
        },
        {% endfor %}{% endfor %}

        {% assign pages = site.pages | where_exp: "shortlink", "shortlink" %}{% for p in pages %}{% for from in p.shortlink %}{% if p.published == true %}
        {
            "from": "{{ from }}.*",
            "to": "{{ p.url }}",
            "status": 301
        },
        {% elsif p.published == "external" %}
        {
            "from": "{{ from }}.*",
            "to": "{{ p.external }}",
            "status": 302
        },
        {
            "from": "{{ p.url }}.*",
            "to": "{{ p.external }}",
            "status": 302
        },
        {% elsif p.published == "private" %}
        {
            "from": "{{ from }}?p={{ p.token }}",
            "to": "{{ p.url }}",
            "status": 302
        },
        {
            "from": "{{ from }}.*",
            "to": "/401.html",
            "status": 401
        },

        {% elsif p.published == "sponsors" or p.published == "pre-sponsors" %}
        {% if p.chapter %}
        {% assign token = site.token.max | divided_by: p.chapter | modulo: site.token.mod | plus: site.token.plus %}
        {% else %}
        {% assign token = '000000' %}
        {% endif %}
        {
            "from": "{{ from }}/?p={{ p.token }}",
            "to": "{{ p.url }}",
            "status": 302
        },
        {
            "from": "{{ from }}.*",
            "to": "/401.html",
            "status": 401
        },

        {% else %}
        {
            "from": "{{ from }}.*",
            "to": "{{ p.url }}",
            "status": 301
        },
        {% endif %}{% endfor %}{% endfor %}

        {
            "from": "/01-life-in-avan-forest/(.*)",
            "to": "/crystaldown/01-life-in-avan-forest/$1",
            "status": 301
        },
        {
            "from": "/02-vampire-aide-and-exodus/(.*)",
            "to": "/crystaldown/02-vampire-aide-and-exodus/$1",
            "status": 301
        },

        {
            "from": "/wordpress/.*/media/.*",
            "to": "/archive/youtube-archive/",
            "status": 301
        },
        {
            "from": "/wordpress/.*/random-stuff/.*",
            "to": "/archive/youtube-archive/",
            "status": 301
        },

        {
            "from": "/elemental-children/(.*)",
            "to": "/scions/$1",
            "status": 301
        },
                                    
        {
            "from": "/([0-9]*)/(.*)",
            "to": "/blog/$1/$2",
            "status": 301
        },
        {
            "from": "/post/([0-9]*)-(.*)",
            "to": "/blog/$1/$2",
            "status": 301
        }
    ]
}

