---
layout: xml
---
<?xml version="1.0" encoding="UTF-8"?>
{% assign pages = site.posts | sort_natural: "date" | reverse %}
<feed xmlns="http://www.w3.org/2005/Atom">
  <generator uri="https://jekyllrb.com/" version="{{ jekyll.version }}">Jekyll</generator>
  <link href="{{ page.url | absolute_url }}" rel="self" type="application/atom+xml" />
  <link href="{{ "/" | absolute_url }}" rel="alternate" type="text/html" />
  <updated>{{ site.time | date_to_xmlschema }}</updated>
  <id>{{ page.url | absolute_url }}</id>
  <title type="html">{{ site.title }} Atom Feed</title>
{% capture now %}{{ 'now' | date: '%s' | plus: 10800 }}{% endcapture %}
{% for page in pages %}
  {% capture post_time %}{{ page.date | date: '%s' }}{% endcapture %}
  {% if jekyll.environment != "unpublished" %}{% if post_time > now %}{% continue %}{% endif %}{% endif %}{% capture description %}{% if page.excerpt %}{{ page.excerpt | markdownify | strip_html | truncatewords: 50, "…" | replace: "&thinsp;", " " }}{% else %}{{ page.content | markdownify | strip_html | truncatewords: 50, "…" | replace: "&thinsp;", " " }}{% endif %}{% endcapture %}
{% unless page.long %}{% continue %}{% endunless %}
  <entry xml:lang="en-CA">
    <title type="html">{{ page.title }}</title>
    {% if page.long %}
      <id>{{ page.url | absolute_url }}</id>
      <link href="{{ page.url | absolute_url }}" rel="alternate" type="text/html" title="{{ page.title }}" />
    {% else %}
      <id>{{ page.category | first | prepend: '/' | absolute_url }}blog/#{{ page.title | slugify }}</id>
      <link href="{{ page.category | first | prepend: '/' | absolute_url }}blog/#{{ page.title | slugify }}" rel="alternate" type="text/html" title="{{ page.title }}" />
    {% endif %}
    <link href="https://fed.brid.gy/" rel="webmention">
    <published>{{ page.date | date_to_xmlschema }}</published>
    <updated>{{ page.last_modified_at | date_to_xmlschema }}</updated>
    <author>{% assign author = site.data.staff | where: 'id', page.author | last%}
      <name>{{ author.name }}</name>
      <uri>{{ author.url }}</uri>
    </author>
    <rights>{{ site.copyright.license | strip_html }} {{ site.copyright.name | strip_html }}</rights>
    <content type="html" xml:base="{{ page.url | absolute_url }}">
      {{ description }}
    </content>
  </entry>{% endfor %}
</feed>
